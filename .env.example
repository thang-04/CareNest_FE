# Base URL of the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api
# Auth riêng: mock = tài khoản demo local (mặc định); gateway = Keycloak qua API CareNest.
VITE_AUTH_MODE=mock
# Chỉ dữ liệu nghiệp vụ: true = bản mẫu, false = API thật; không quyết định auth.
VITE_USE_MOCK=true
# Mở khu Nhân sự mới trong API thật sau khi BE có staffOnly/roster và smoke test đạt.
VITE_PEOPLE_CONTRACT_READY=false

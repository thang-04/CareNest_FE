# Base URL of the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api
# true = use the localStorage mock repository, false = call the real API via axios
VITE_USE_MOCK=true
# Dev: đăng nhập bằng tài khoản Keycloak dev (email @carenest.test, mật khẩu = KEYCLOAK_DEV_USER_PASSWORD trong .env của
# CareNest_BE) và nối các màn đã có API với BE thật; module khác vẫn mock. Cần Keycloak (:8180) và BE chạy.
VITE_SCHOOL_CONFIG_API=false
# Chỉ dev: thử kích hoạt / kết thúc năm học trước hạn (BE bật CARENEST_DEV_ACTIVATION_SKIP_* tương ứng)
VITE_DEV_SKIP_YEAR_DATES=false

{
  "name": "carenest-fe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "check:design": "node scripts/check-design.mjs",
    "check": "npm run lint && npm run format:check && npm run check:design && npm run build",
    "verify": "npm run test:menu && npm run test:kitchen && npm run test:merge && npm run test:hardening && npm run test:dashboard && npm run check",
    "test:menu": "node --import ./scripts/register-auth-test-loader.mjs --test tests/menu/*.test.mjs",
    "test:kitchen": "node --import ./scripts/register-auth-test-loader.mjs --test tests/kitchen/*.test.mjs",
    "test:merge": "node --import ./scripts/register-auth-test-loader.mjs --test tests/integration/selective-merge/*.test.mjs",
    "test:hardening": "node --import ./scripts/register-auth-test-loader.mjs --test tests/hardening/*.test.mjs",
    "test:dashboard": "node --import ./scripts/register-auth-test-loader.mjs --test tests/dashboard/*.test.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "axios": "^1.7.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "vite": "^8.3.3"
  }
}

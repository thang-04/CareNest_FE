{
  "name": "carenest-fe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "check:design": "node scripts/check-design.mjs",
    "check:api": "node scripts/check-api-contract.mjs",
    "check": "npm run lint && npm run format:check && npm run check:design && npm run check:api && npm run build",
    "test": "npm run test:auth && npm run test:menu && npm run test:kitchen && npm run test:merge && npm run test:hardening && npm run test:dashboard && npm run test:health && npm run test:children && npm run test:pickup && npm run test:edu && npm run test:assessment",
    "verify": "npm run test:auth && npm run test:menu && npm run test:kitchen && npm run test:merge && npm run test:hardening && npm run test:dashboard && npm run test:health && npm run test:children && npm run test:edu && npm run test:assessment && npm run check",
    "test:auth": "node --import ./scripts/register-auth-test-loader.mjs --test tests/auth/*.test.mjs",
    "test:menu": "node --import ./scripts/register-auth-test-loader.mjs --test tests/menu/*.test.mjs",
    "test:kitchen": "node --import ./scripts/register-auth-test-loader.mjs --test tests/kitchen/*.test.mjs",
    "test:merge": "node --import ./scripts/register-auth-test-loader.mjs --test tests/integration/selective-merge/*.test.mjs",
    "test:hardening": "node --import ./scripts/register-auth-test-loader.mjs --test tests/hardening/*.test.mjs",
    "test:dashboard": "node --import ./scripts/register-auth-test-loader.mjs --test tests/dashboard/*.test.mjs",
    "test:health": "node --import ./scripts/register-auth-test-loader.mjs --test tests/health/*.test.mjs",
    "test:children": "node --import ./scripts/register-auth-test-loader.mjs --test tests/children/*.test.mjs",
    "test:pickup": "node --import ./scripts/register-auth-test-loader.mjs --test tests/pickup/*.test.mjs",
    "test:edu": "node --import ./scripts/register-auth-test-loader.mjs --test tests/education-plan/*.test.mjs",
    "test:assessment": "node --import ./scripts/register-auth-test-loader.mjs --test tests/assessment/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:system": "playwright test --project=system --no-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bold": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-hard-break": "^3.35.0",
    "@tiptap/extension-italic": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "axios": "^1.7.9",
    "dompurify": "^3.4.18",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lottie-web": "5.13.0",
    "mammoth": "^1.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "vite": "^8.3.3"
  }
}

{
  "repo": "FE",
  "siblings": {
    "BE": [
      "../CareNest_BE"
    ],
    "FE": [
      "../CareNest_FE"
    ],
    "APP": [
      "../CareNest_APP"
    ]
  },
  "lanes": {
    "smallMaxFiles": 2,
    "mediumMaxFiles": 8,
    "riskGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc",
      "src/components/ui/**",
      "src/components/form/**",
      "src/styles/*.css",
      "src/layouts/**",
      "src/routes/**",
      "src/contexts/**",
      "src/utils/*.js",
      "src/config/**",
      "src/services/http/**",
      "src/hooks/*.js"
    ]
  },
  "verify": {
    "activeWhen": [
      "package.json"
    ],
    "globs": [
      "src/**",
      "package.json",
      "tsconfig*.json",
      "public/**"
    ],
    "display": "node scripts/verify.mjs"
  },
  "guard": {
    "autonomous": true,
    "dependencyGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc"
    ],
    "immutableGlobs": [],
    "contractGlobs": [],
    "highRisk": [],
    "sharedGlobs": [
      "src/components/ui/**",
      "src/components/form/**",
      "src/styles/*.css",
      "src/layouts/**",
      "src/routes/**",
      "src/contexts/**",
      "src/utils/*.js",
      "src/config/**",
      "src/services/http/**",
      "src/hooks/*.js"
    ]
  },
  "checkAiLayer": {
    "pathRoots": [
      "docs",
      ".ai"
    ],
    "incidentIdPattern": "^FE-(BUG|CASE|ENV)-\\d{6}-[a-z0-9-]+$"
  }
}
